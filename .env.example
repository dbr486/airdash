# Your position, decimal degrees. Required.
AIRDASH_LAT=51.4700
AIRDASH_LON=-0.4500

# Optional. Defaults shown.
#AIRDASH_RADIUS_KM=10
#AIRDASH_POLL_SECONDS=5
#AIRDASH_LISTEN=:8080
# Host port published by docker compose. Inside the container the service
# always listens on :8080; AIRDASH_LISTEN only applies when running the
# binary directly.
#AIRDASH_PORT=8080
# Host port for the web UI (docker compose).
#AIRDASH_UI_PORT=3000
# adsbfi (default, 1 request/s allowed) or adsblol (rate-limited to
# ~8/min; use AIRDASH_POLL_SECONDS=10 or more)
#AIRDASH_PROVIDER=adsbfi
#AIRDASH_ROUTE_CACHE_HOURS=6

# Airport filters, comma-separated IATA or ICAO codes. Empty = no filter.
# Within a variable: any of. Across variables: all of.
# departing from
#AIRDASH_ORIGIN=LHR,LGW
# arriving at
#AIRDASH_DEST=BCN
# either end
#AIRDASH_AIRPORT=LHR

# Filters and radius can also be changed at runtime from the web UI
# (http://localhost:3000). Those changes persist in the Docker volume and
# override the values above until you change them again.
# Standalone binary only; docker compose sets /data/settings.json itself.
#AIRDASH_SETTINGS_FILE=

# FlightAware AeroAPI key (Personal tier) for on-time / delayed status.
# Optional: without it the delay feature is off. Never commit the real key.
#AIRDASH_AEROAPI_KEY=

# AirLabs key (free tier: 1,000 calls/month) for the airport departures /
# arrivals board, which gives delay status for every flight touching the
# board airport without per-flight AeroAPI calls. Never commit the key.
#AIRDASH_AIRLABS_KEY=
# The board airport (IATA or ICAO); also editable on the settings page.
#AIRDASH_BOARD_AIRPORT=LHR
# Refresh interval in minutes (min 5; 100 keeps a free key under its cap)
# and the monthly call cap the service enforces itself (2 calls/refresh).
#AIRDASH_BOARD_REFRESH_MINUTES=100
#AIRDASH_BOARD_CALLS_PER_MONTH=900
